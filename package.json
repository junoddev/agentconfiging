{
  "name": "agentconfiging",
  "version": "0.1.3",
  "description": "Local control center for AI agent configuration. `npx agentconfiging` opens a web UI over the agent setup in your repo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junoddev/agentconfiging.git"
  },
  "bugs": {
    "url": "https://github.com/junoddev/agentconfiging/issues"
  },
  "homepage": "https://agentconfig.ing",
  "keywords": [
    "ai-agents",
    "agent-config",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "agentconfiging": "dist/cli/index.js"
  },
  "main": "dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/dev-server.ts",
    "dev:web": "vite web",
    "clean:tsup": "node -e \"const fs=require('fs');['cli','server','core'].forEach(d=>fs.rmSync('dist/'+d,{recursive:true,force:true}));fs.existsSync('dist')&&fs.readdirSync('dist').forEach(f=>(f.endsWith('.js')||f.endsWith('.js.map'))&&fs.rmSync('dist/'+f,{force:true}))\"",
    "build": "npm run clean:tsup && tsup && vite build web",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:security": "node scripts/security-gate.mjs",
    "profiles:list": "tsx src/cli/index.ts profiles list",
    "profiles:show": "tsx src/cli/index.ts profiles show",
    "profiles:audit": "tsx src/cli/index.ts profiles audit",
    "profiles:refresh": "node scripts/profile-refresh.mjs",
    "profiles:refresh:policy": "node scripts/profile-refresh-policy.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "e2e:browser": "node scripts/e2e-browser.mjs",
    "release:gate": "npm run lint && npm run typecheck && npm run test:security && npm test && npm run build && npm run e2e && npm run e2e:browser",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.0",
    "hono": "^4.12.32",
    "ink": "^6.0.0",
    "react": "^19.2.8",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0",
    "node-pty": "^1.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
